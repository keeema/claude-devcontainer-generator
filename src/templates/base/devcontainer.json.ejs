<%
const baseExtensions = [
  "anthropic.claude-code",
  "esbenp.prettier-vscode",
  "dbaeumer.vscode-eslint",
  "biomejs.biome",
  "redhat.vscode-yaml",
  "streetsidesoftware.code-spell-checker",
  "streetsidesoftware.code-spell-checker-czech",
  "hashicorp.terraform",
  "github.vscode-github-actions",
  "styled-components.vscode-styled-components",
  "mhutchie.git-graph",
  "donjayamanne.githistory",
];
const extensions = [...baseExtensions];
if (stack.vscode_extensions) {
  extensions.push(...stack.vscode_extensions);
}

// Build forwardPorts and portsAttributes.
//
// Služby běží jako SAMOSTATNÉ compose kontejnery, takže se forwardují formou
// "service:containerPort" — holé číslo by tunelovalo localhost devcontaineru,
// kde tyto služby neposlouchají (viz containers.dev json_reference). Klíč v
// portsAttributes musí přesně odpovídat zápisu ve forwardPorts.
const forwardPorts = [];
const portsAttributes = {};

for (const [svcName, svc] of Object.entries(services)) {
  if (!svc.ports) continue;
  for (const portMapping of svc.ports) {
    const parts = String(portMapping).split(':');
    const containerPort = parts.length > 1 ? parts[1] : parts[0];
    const key = `${svcName}:${containerPort}`;
    forwardPorts.push(key);
    portsAttributes[key] = { label: svc.display_name, onAutoForward: "silent" };
  }
}
-%>
{
  "dockerComposeFile": "docker-compose.yml",
  "service": "devcontainer",
  "workspaceFolder": "/workspace",
  "remoteUser": "node",

  "customizations": {
    "vscode": {
      "extensions": <%- JSON.stringify(extensions) %>,
      "settings": {
        "claude-code.enableAutoSkipPermissions": true,
        "remote.autoForwardPorts": false,
        "remote.restoreForwardedPorts": false,
        "git.terminalAuthentication": false,
        "dev.containers.gitCredentialHelperConfigLocation": "none"
      }
    }
  },

  // forwardPorts = zpřístupnění portů na localhost lokálního stroje. Služby jsou
  // samostatné compose kontejnery → forma "service:port" (lokálně se navážou na
  // číslo za dvojtečkou). Vždy jsou navíc dostupné přes docker-compose publish na
  // <host>:<port>. Proces běžící UVNITŘ devcontaineru (dev server frontendu/
  // backendu) forwarduj holým číslem — užitečné pro stabilní OIDC redirect URI na
  // localhost, např.: "forwardPorts": [5173, <%- forwardPorts.length ? JSON.stringify(forwardPorts[0]) : '"postgres:5432"' %>].
  "forwardPorts": <%- JSON.stringify(forwardPorts) %>,

  "portsAttributes": <%- JSON.stringify(portsAttributes, null, 2).replace(/\n/g, '\n  ') %>,

  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },

  "containerEnv": {
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "CLAUDE_CONFIG_DIR": "/home/node/.claude",
    "POWERLEVEL9K_DISABLE_GITSTATUS": "true"
  },

  "remoteEnv": {
    "VSCODE_GIT_ASKPASS_MAIN": "",
    "VSCODE_GIT_ASKPASS_NODE": "",
    "VSCODE_GIT_ASKPASS_EXTRA_ARGS": "",
    "VSCODE_GIT_IPC_HANDLE": "",
    "GIT_ASKPASS": ""
  },

  // Cross-platform dispatch: cmd.exe (Windows) spustí init.cmd; pod /bin/sh se
  // backslash slije do neexistujícího tokenu, první příkaz selže a Mac/Linux
  // propadne na wrapper init. Uvozovky tu nesmí být — VS Code je escapuje, když
  // spouští cmd.exe. Na macOS proto v logu vždy nejdřív probleskne
  // "sh: .devcontainerinit.cmd: command not found" — je to očekávané.
  "initializeCommand": ".devcontainer\\init.cmd || .devcontainer/init"<% if (!fullInternet) { %>,
  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh",
  "waitFor": "postStartCommand"<% } %>
}
