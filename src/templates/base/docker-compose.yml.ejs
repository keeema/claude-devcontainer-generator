name: <%= name %>
<%_ if (includeCompose) { _%>

include:
  - path: ../../<%= name %>/docker-compose.yml
<%_ } _%>

services:
  devcontainer:
    build:
      context: .
      dockerfile: Dockerfile
    volumes:
      - ../../<%= name %>:/workspace/<%= name %>:cached
      - ../../<%= name %>-devcontainer:/workspace/<%= name %>-devcontainer:cached
      - ../../<%= name %>-devcontainer/<%= name %>.code-workspace:/workspace/<%= name %>.code-workspace:cached
      - claude-shared:/home/node/.claude
      - <%= name %>-git-credentials:/home/node/.gitcreds
<%_ if (localClaude) { _%>
      # Claude běží s cwd /workspace → workspace-level kontext musí být zde.
      - ../../<%= name %>-devcontainer/.workspace-claude:/workspace/.claude:cached
      - ../../<%= name %>-devcontainer/.project-claude:/workspace/<%= name %>/.claude:cached
<%_ } _%>
      - <%= name %>-commandhistory:/commandhistory
    # Vstup do kontejneru: VS Code (Reopen in Container), nebo z hostu
    # `docker exec -it <kontejner> zsh` a `tmux attach -t claude`.
    command: >
      bash -c "tmux new-session -d -s claude 'claude --dangerously-skip-permissions' && sleep infinity"
<%_ if (!fullInternet) { _%>
    cap_add:
      - NET_ADMIN
      - NET_RAW
<%_ } _%>
    environment:
      - CLAUDE_CONFIG_DIR=/home/node/.claude
<%_ for (const [svcName, svc] of Object.entries(services)) { _%>

  <%= svcName %>:
    image: <%= svc.image %>
<%_ if (svc.env) { _%>
    environment:
<%_ for (const [key, val] of Object.entries(svc.env)) { _%>
      - <%= key %>=<%= val %>
<%_ } _%>
<%_ } _%>
<%_ if (svc.ports) { _%>
    ports:
<%_ for (const port of svc.ports) { _%>
      - "<%= port %>"
<%_ } _%>
<%_ } _%>
<%_ if (svc.volumes) { _%>
    volumes:
<%_ for (const vol of svc.volumes) { _%>
      - <%= vol %>
<%_ } _%>
<%_ } _%>
<%_ } _%>

volumes:
  claude-shared:
    external: true
  <%= name %>-git-credentials:
    external: true
  <%= name %>-commandhistory:
<%_ for (const volName of Object.keys(serviceVolumes)) { _%>
  <%= volName %>:
<%_ } _%>
